generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  reminderDays Int      @default(7)
  createdAt    DateTime @default(now())

  categories Category[]
  bills      Bill[]
  budgets    Budget[]

  ownedHouseholds       Household[]
  householdMemberships  HouseholdMember[]
}

model Category {
  id        String   @id @default(uuid())
  name      String
  icon      String?
  color     String?
  userId    String
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bills   Bill[]
  budgets Budget[]

  @@index([userId])
}

model Bill {
  id            String         @id @default(uuid())
  title         String
  amount        Float
  dueDate       DateTime
  paidAt        DateTime?
  status        BillStatus     @default(UNPAID)
  notes         String?
  isRecurring   Boolean        @default(false)
  receiptUrl    String?
  receiptName   String?
  paymentMethod PaymentMethod?
  householdId   String?
  userId        String
  categoryId    String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  household Household?  @relation(fields: [householdId], references: [id], onDelete: SetNull)
  splits    BillSplit[]

  @@index([userId, dueDate])
  @@index([userId, status])
  @@index([categoryId])
  @@index([householdId])
}

model Budget {
  id         String   @id @default(uuid())
  amount     Float
  month      Int
  year       Int
  userId     String
  categoryId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId, month, year])
  @@index([categoryId])
}

model AiRequestLog {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Household {
  id        String   @id @default(uuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())

  owner   User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members HouseholdMember[]
  bills   Bill[]
}

model HouseholdMember {
  id          String       @id @default(uuid())
  householdId String
  userId      String?
  email       String
  name        String?
  status      MemberStatus @default(PENDING)
  invitedAt   DateTime     @default(now())
  joinedAt    DateTime?

  household Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  splits    BillSplit[]

  @@unique([householdId, email])
  @@index([userId])
}

model BillSplit {
  id                 String    @id @default(uuid())
  billId             String
  householdMemberId  String
  amount             Float
  isPaid             Boolean   @default(false)
  paidAt             DateTime?
  createdAt          DateTime  @default(now())

  bill            Bill            @relation(fields: [billId], references: [id], onDelete: Cascade)
  householdMember HouseholdMember @relation(fields: [householdMemberId], references: [id], onDelete: Cascade)

  @@unique([billId, householdMemberId])
  @@index([billId])
  @@index([householdMemberId])
}

enum BillStatus {
  UNPAID
  PAID
  OVERDUE
}

enum PaymentMethod {
  CASH
  GCASH
  MAYA
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  OTHER
}

enum MemberStatus {
  PENDING
  ACCEPTED
}